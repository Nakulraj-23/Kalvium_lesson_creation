# AI provider - at least one key is required.
# Groq (recommended, free, fast): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (optional with Groq; adds Google-Search grounding for research + QC1 web verification):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# groq | gemini  (default: groq if GROQ_API_KEY is set)
LLM_PROVIDER=
# Optional: Groq model preference order (available models are detected automatically)
GROQ_MODELS=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_QC_MODEL=gemini-3.5-flash

# Optional extras
USE_GROUNDED_SEARCH=true
YOUTUBE_API_KEY=              # if empty, YouTube is searched with yt-dlp (no key needed)
GOOGLE_BOOKS_API_KEY=         # works without a key
MAX_WEB_SOURCES=8
HTTP_TIMEOUT=15
